<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.training.mapper.ClazzStudentMapper">

    <resultMap id="BaseResultMap" type="com.training.entity.ClazzStudent">
        <id column="id" property="id"/>
        <result column="clazz_id" property="clazzId"/>
        <result column="student_id" property="studentId"/>
        <result column="joined_at" property="joinedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, clazz_id, student_id, joined_at
    </sql>

    <select id="selectByClazzId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM clazz_student WHERE clazz_id = #{clazzId}
    </select>

    <select id="selectByStudentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM clazz_student WHERE student_id = #{studentId}
    </select>

    <select id="selectByClazzAndStudent" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM clazz_student WHERE clazz_id = #{clazzId} AND student_id = #{studentId}
    </select>

    <insert id="insert">
        INSERT INTO clazz_student (clazz_id, student_id, joined_at)
        VALUES (#{clazzId}, #{studentId}, #{joinedAt})
    </insert>

    <delete id="deleteById">
        DELETE FROM clazz_student WHERE id = #{id}
    </delete>

    <delete id="deleteByClazzAndStudent">
        DELETE FROM clazz_student WHERE clazz_id = #{clazzId} AND student_id = #{studentId}
    </delete>

    <select id="countByClazzId" resultType="int">
        SELECT COUNT(*) FROM clazz_student WHERE clazz_id = #{clazzId}
    </select>

</mapper>
