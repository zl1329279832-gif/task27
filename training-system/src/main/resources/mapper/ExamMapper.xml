<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.training.mapper.ExamMapper">

    <resultMap id="BaseResultMap" type="com.training.entity.Exam">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="course_id" property="courseId"/>
        <result column="duration_minutes" property="durationMinutes"/>
        <result column="total_score" property="totalScore"/>
        <result column="pass_score" property="passScore"/>
        <result column="question_count" property="questionCount"/>
        <result column="max_attempts" property="maxAttempts"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, title, course_id, duration_minutes, total_score, pass_score,
        question_count, max_attempts, status, created_by, created_at, updated_at
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM exam
        WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM exam
        <where>
            <if test="courseId != null">
                AND course_id = #{courseId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <insert id="insert" parameterType="com.training.entity.Exam" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO exam (title, course_id, duration_minutes, total_score, pass_score,
                          question_count, max_attempts, status, created_by, created_at, updated_at)
        VALUES (#{title}, #{courseId}, #{durationMinutes}, #{totalScore}, #{passScore},
                #{questionCount}, #{maxAttempts}, #{status}, #{createdBy}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="updateById" parameterType="com.training.entity.Exam">
        UPDATE exam
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="courseId != null">course_id = #{courseId},</if>
            <if test="durationMinutes != null">duration_minutes = #{durationMinutes},</if>
            <if test="totalScore != null">total_score = #{totalScore},</if>
            <if test="passScore != null">pass_score = #{passScore},</if>
            <if test="questionCount != null">question_count = #{questionCount},</if>
            <if test="maxAttempts != null">max_attempts = #{maxAttempts},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM exam WHERE id = #{id}
    </delete>

    <update id="updateStatus">
        UPDATE exam
        SET status = #{status}
        WHERE id = #{id}
    </update>

</mapper>
